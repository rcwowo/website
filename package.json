    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "remark-emoji": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-astro-organize-imports": "^0.4.13",
    "prettier-plugin-tailwindcss": "^0.5.14"
