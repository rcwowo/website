---
import Link from '@/components/Link.astro'
import ProjectList from '@/components/ProjectList.astro'
import OwoGrid from '@/components/widgets/OwoGrid'
import RecentPosts from '@/components/widgets/RecentPosts'
import Section from '@/components/Section.astro'
import SocialIcons from '@/components/SocialIcons.astro'
import { BLOG_URL, SITE, TAGLINES } from '@/consts'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Home" description={SITE.DESCRIPTION}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <OwoGrid client:load />
    <div class="hero-veil pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex min-h-[30rem] w-full max-w-[50rem] flex-col justify-end px-6 pt-24 pb-10 md:min-h-[32rem] md:pt-28 md:pb-10">
      <div class="hero-copy flex flex-col items-start text-left">
        <h1 class="hero-title font-display text-5xl font-extrabold tracking-tight md:text-7xl">
          {SITE.TITLE}
        </h1>
        <p
          id="tagline"
          class="hero-tagline max-w-lg min-h-[1.75rem] text-lg text-muted-foreground leading-relaxed"
        ></p>
        <div class="hero-roles flex items-center gap-3 text-sm text-muted-foreground/70">
          <span>video editor</span>
          <span class="h-1 w-1 rounded-full bg-accent/40"></span>
          <span>web developer</span>
          <span class="h-1 w-1 rounded-full bg-accent/40"></span>
          <span>he/him</span>
        </div>
        <div class="hero-socials pt-4">
          <SocialIcons />
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <Section id="projects" class="flex flex-col gap-8">
    <h2 class="projects-heading font-display text-2xl font-bold tracking-tight">Projects</h2>
    <ProjectList />
  </Section>

  <!-- Recent posts -->
  <Section class="flex flex-col gap-6 pt-10 pb-20">
    <div class="flex items-baseline justify-between">
      <h2 class="writing-heading font-display text-2xl font-bold tracking-tight">Writing</h2>
      <Link
        href={BLOG_URL}
        external
        class="text-xs text-muted-foreground/50 transition-colors hover:text-accent"
      >
        View all &rarr;
      </Link>
    </div>
    <RecentPosts client:load />
  </Section>

</Layout>

<script is:inline define:vars={{ TAGLINES }}>
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('tagline')
    if (!el) return

    el.textContent = TAGLINES[Math.floor(Math.random() * TAGLINES.length)]

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('tagline-visible')
      return
    }

    requestAnimationFrame(() => {
      el.classList.add('tagline-visible')
    })
  })
</script>

<style>
  .hero-veil {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 32%,
      hsl(250 15% 4% / 0.4) 52%,
      hsl(250 15% 4% / 0.82) 74%,
      hsl(250 15% 4%) 100%
    );
  }

  .hero-copy {
    position: relative;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    inset: -2rem -2.5rem -1.5rem -1.25rem;
    background: radial-gradient(
      ellipse 90% 85% at 12% 70%,
      hsl(250 15% 4% / 0.58) 0%,
      hsl(250 15% 4% / 0.2) 48%,
      transparent 74%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-title {
    animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    text-shadow:
      0 0 18px hsl(250 15% 4% / 0.9),
      0 2px 28px hsl(250 15% 4% / 0.7);
  }
  .hero-tagline,
  .hero-roles,
  .hero-socials {
    text-shadow: 0 0 16px hsl(250 15% 4% / 0.85);
  }

  .hero-tagline {
    opacity: 0;
    transform: translateY(10px);
  }

  .hero-tagline.tagline-visible {
    animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tagline.tagline-visible {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  .hero-roles {
    animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
  }
  .hero-socials {
    animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }
  .projects-heading {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
  }
  .writing-heading {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }
  .post-row {
    animation: fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

</style>
