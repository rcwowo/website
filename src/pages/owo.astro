---
import OwoGrid from '@/components/widgets/OwoGrid'
import Head from '@/components/Head.astro'
import { SITE } from '@/consts'
---

<!doctype html>
<html lang="en" class="owo-stage-page">
  <head>
    <Head title={`OwO - ${SITE.TITLE}`} description="OwO" router={false} />
  </head>
  <body>
    <h1 class="sr-only">OwO</h1>
    <div class="owo-stage">
      <OwoGrid client:load mode="stage" />
    </div>
  </body>
</html>

<style is:global>
  html.owo-stage-page,
  html.owo-stage-page body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  html.owo-stage-page body {
    position: relative;
    z-index: 0;
  }

  .owo-stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
</style>
